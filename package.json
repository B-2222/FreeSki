{
  "name": "frostline",
  "private": true,
  "version": "0.1.0",
  "description": "FROSTLINE: a free browser freeski game",
  "type": "module",
  "scripts": {
    "dev": "vite --config client/vite.config.ts",
    "build": "tsc --noEmit && vite build --config client/vite.config.ts",
    "preview": "vite preview --config client/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "plan": "tsx shared/tools/planCourse.ts",
    "budget": "tsx shared/tools/spinBudget.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
